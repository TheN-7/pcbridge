# Python
__pycache__/
*.pyc
*.pyo

# Local config/logs (contains your real PIN, folder path, and GitHub
# update token -- don't publish)
config.json
pcbridge.log

# Self-signed TLS cert + private key, generated on first run (see
# ensure_certificate() in server.py). Regenerating a new one is harmless
# for you, but every app that already pinned the old one will refuse to
# connect until you re-add this PC there -- so don't casually delete
# these, and definitely don't commit key.pem anywhere.
cert.pem
key.pem

# Auto-update runtime artifacts (only appear next to a running install)
PCBridge_update.exe
pcbridge_update.ps1
pcbridge_update.log

# Generated by CI right before building -- bakes update_repo/token into
# the exe. Never actually written locally, but ignored just in case.
update_secrets.py

# PyInstaller build output
build/
dist/
icon.ico

# Inno Setup installer output
installer/installer_output/

# Android / Gradle
android/.gradle/
android/.idea/
android/local.properties
android/app/build/
android/build/
*.iml

# Android release signing key -- NEVER commit. Losing this means every
# future release needs a fresh signing key and every existing install
# needs an uninstall+reinstall to move to it. Back it up separately.
android/keystore.properties
android/keystore/

# OS cruft
.DS_Store
Thumbs.db
