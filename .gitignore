# ---- build output ----
node_modules/
build/
.svelte-kit/
src-tauri/target/
src-tauri/gen/
# Packaged installers. Attached to GitHub Releases instead: binaries in
# git are permanent -- every clone pays for them forever, and removing
# one later means rewriting history.
dist/

# ---- runtime state ----
# These are generated next to the app at runtime, never in the repo, but
# they are ignored explicitly because of what they contain:
#
#   settings.json  your real PIN and the path you're sharing
#   devices.json   paired devices' pinned fingerprints and their PINs
#   key.pem        the private key for this machine's TLS identity
#
# Committing key.pem would let anyone impersonate this PC to every
# device that has already pinned it — which is the one failure the
# trust-on-first-use model cannot detect.
settings.json
devices.json
cert.pem
key.pem
*.log

# ---- signing / release material ----
# Never commit. Losing the Android keystore means every existing install
# needs an uninstall before it can take another update.
keystore/
keystore.properties
update_secrets.*

# ---- editors / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- stray build output ----
# dist/ above covers the bundler's own output directory. This catches an
# installer copied somewhere else in the tree to be tested or attached to
# a release: 4 MB, and once committed it is in every clone forever.
*.exe
*.msi
