<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Required at runtime on Android 13+ to show the upload-complete notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the app open the system installer on an APK it downloaded
         itself (auto-update). Android still requires the user to grant
         "install unknown apps" for this app once, and to tap Install on
         the system's own confirmation screen every time; this permission
         only declares the *intent*, it doesn't skip either of those. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PCBridge"
        android:usesCleartextTraffic="true">

        <!--
          usesCleartextTraffic is required because this app talks to your PC
          over plain http:// on your local network or Tailscale tailnet
          (no public internet exposure, no TLS cert available for a LAN IP).
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PcBridgeWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pcbridge_widget_info" />
        </receiver>

        <!-- Hands the downloaded update APK a content:// URI so the
             system installer (a different app) is allowed to read it.
             Plain file:// URIs across app boundaries are blocked since
             Android 7. See res/xml/file_paths.xml for what's exposed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
