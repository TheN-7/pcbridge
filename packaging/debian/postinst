#!/bin/sh
# Refreshes the desktop menu / icon caches so PC Bridge shows up in the
# application launcher immediately after install, without needing a
# logout. Both commands are optional depending on desktop environment
# (a minimal/server install may have neither) -- guarded and non-fatal
# either way, since a missing menu entry is cosmetic, not worth failing
# the whole package install over.
set -e

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -f /usr/share/icons/hicolor || true
fi

exit 0
